From eefa5f2996f988ba420a9d5221dd109d6948cacc Mon Sep 17 00:00:00 2001
From: xiexgxgxgxg <xiangtaozichidexie@gmail.com>
Date: Thu, 19 Nov 2026 20:43:15 +0800
Subject: [PATCH] sdcard: use the 3.18 sdcardfs option names

The A11 sdcard userspace passes fsuid/fsgid/multiuser/derive_gid/
default_normal/unshared_obb and mask=%d, but the Samsung 3.18 sdcardfs
only knows low_uid/low_gid/multi_user and mask=%o.  Every mount failed
with -EINVAL, /system/bin/sdcard aborted with 'failed to sdcardfs_setup',
and /storage/emulated/0 was never mounted (MediaStore had no external
volume, music/file manager saw no internal storage).

Emit the option names and octal mask the kernel understands.  vold now
mounts the sdcardfs lower and the FUSE upper correctly.

Change-Id: I06de019d42ec8f3e14c08628d136975572921ccb
---
 sdcard/sdcard.cpp | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/sdcard/sdcard.cpp b/sdcard/sdcard.cpp
index 622de5b7a..0fb68633d 100644
--- a/sdcard/sdcard.cpp
+++ b/sdcard/sdcard.cpp
@@ -104,10 +104,13 @@ static bool sdcardfs_setup(const std::string& source_path, const std::string& de
                            bool use_esdfs) {
     // Add new options at the end of the vector.
     std::vector<std::string> new_opts_list;
-    if (multi_user) new_opts_list.push_back("multiuser,");
-    if (derive_gid) new_opts_list.push_back("derive_gid,");
-    if (default_normal) new_opts_list.push_back("default_normal,");
-    if (unshared_obb) new_opts_list.push_back("unshared_obb,");
+    // The 3.18 Samsung sdcardfs only knows these option names and has no
+    // derive_gid/default_normal/unshared_obb support; A11's names made every
+    // mount fail with -EINVAL and aborted /system/bin/sdcard.
+    if (multi_user) new_opts_list.push_back("multi_user,");
+    (void)derive_gid;
+    (void)default_normal;
+    (void)unshared_obb;
     // Try several attempts, each time with one less option, to gracefully
     // handle older kernels that aren't updated yet.
     for (int i = 0; i <= new_opts_list.size(); ++i) {
@@ -116,7 +119,7 @@ static bool sdcardfs_setup(const std::string& source_path, const std::string& de
             new_opts += new_opts_list[j];
         }
 
-        auto opts = android::base::StringPrintf("fsuid=%d,fsgid=%d,%smask=%d,userid=%d,gid=%d",
+        auto opts = android::base::StringPrintf("low_uid=%d,low_gid=%d,%smask=%o,userid=%d,gid=%d",
                                                 fsuid, fsgid, new_opts.c_str(), mask, userid, gid);
         if (mount(source_path.c_str(), dest_path.c_str(), use_esdfs ? "esdfs" : "sdcardfs",
                   MS_NOSUID | MS_NODEV | MS_NOEXEC | MS_NOATIME, opts.c_str()) == -1) {
@@ -131,7 +134,7 @@ static bool sdcardfs_setup(const std::string& source_path, const std::string& de
 
 static bool sdcardfs_setup_bind_remount(const std::string& source_path, const std::string& dest_path,
                                         gid_t gid, mode_t mask) {
-    std::string opts = android::base::StringPrintf("mask=%d,gid=%d", mask, gid);
+    std::string opts = android::base::StringPrintf("mask=%o,gid=%d", mask, gid);
 
     if (mount(source_path.c_str(), dest_path.c_str(), nullptr,
             MS_BIND, nullptr) != 0) {
-- 
