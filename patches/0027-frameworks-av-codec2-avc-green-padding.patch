From 8e3a61621d42a2c566890310b563516fc78d4099 Mon Sep 17 00:00:00 2001
From: xiexgxgxgxg <xiangtaozichidexie@gmail.com>
Date: Sat, 28 Nov 2026 16:44:58 +0800
Subject: [PATCH] codec2: hide the camera HAL's green padding rows in the soft
 AVC encoder

The 6.0.1 camera HAL pads its CPP output to a 64-line boundary and scales
it back without cropping, so the bottom ceil(h/64) rows of every recorded
frame (16 rows at 1920x1080) are zero, which players show as a green band.

Before handing a frame to the encoder, copy the last valid row over those
rows.  The frame dimensions do not change, so MediaRecorder/MPEG4Writer are
unaffected; cropping the encoded height instead makes MediaRecorder fail
with 'stop failed: -1007'.

Change-Id: I649edd6e08af103753cbbb0bd0ecc0dff1ff7ec9
---
 media/codec2/components/avc/C2SoftAvcEnc.cpp | 28 ++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/media/codec2/components/avc/C2SoftAvcEnc.cpp b/media/codec2/components/avc/C2SoftAvcEnc.cpp
index 566895fa6b..1563eb29f6 100644
--- a/media/codec2/components/avc/C2SoftAvcEnc.cpp
+++ b/media/codec2/components/avc/C2SoftAvcEnc.cpp
@@ -1320,6 +1320,34 @@ c2_status_t C2SoftAvcEnc::setEncodeArgs(
             return C2_BAD_VALUE;
     }
 
+    /* W2017: the 6.0.1 camera HAL pads its CPP output to a 64-line boundary
+     * and scales it back without cropping, so the bottom ceil(h/64) rows of
+     * every frame are zero (green on playback).  Copy the last valid row over
+     * them before handing the frame to the encoder: no dimension change, so
+     * MediaRecorder/MPEG4Writer stay happy. */
+    if (height > 64 && yStride > 0) {
+        uint32_t crop = (height + 63) / 64;
+        if (height > crop + 1) {
+            uint32_t validH = height - crop;
+            for (uint32_t y = validH; y < height; y++) {
+                memcpy(yPlane + (size_t)y * yStride,
+                       yPlane + (size_t)(validH - 1) * yStride, width);
+            }
+            if (uStride > 0 && uPlane != NULL) {
+                uint32_t uvH = height / 2, uvValid = validH / 2;
+                uint32_t uvW = (mIvVideoColorFormat == IV_YUV_420P) ? width / 2 : width;
+                for (uint32_t y = uvValid; y < uvH; y++) {
+                    memcpy(uPlane + (size_t)y * uStride,
+                           uPlane + (size_t)(uvValid - 1) * uStride, uvW);
+                    if (mIvVideoColorFormat == IV_YUV_420P && vPlane != NULL && vStride > 0) {
+                        memcpy(vPlane + (size_t)y * vStride,
+                               vPlane + (size_t)(uvValid - 1) * vStride, uvW);
+                    }
+                }
+            }
+        }
+    }
+
     switch (mIvVideoColorFormat) {
         case IV_YUV_420P:
         {
-- 
2.53.0

