+namespace {
+
+/*
+ * The wrapped 6.0.1 HAL was compiled against the Android 6 Qualcomm
+ * private_handle_t: [0] fd, [1] fd_metadata, [2] magic, [3] flags,
+ * [4] size, [5] offset, [6] bufferType, [7..8] base, [9] offset_metadata,
+ * [10..11] gpuaddr, [12] format, [13] width, [14] height, [15..] ...
+ *
+ * The Android 11 gralloc used here keeps the allocated width/height at
+ * [4]/[5] and the real buffer size at [10], so the HAL registers every buffer
+ * with "size = allocated width, offset = allocated height" and, for the JPEG
+ * path, reads a zero length and writes the blob header below the buffer
+ * (SIGSEGV in QCamera3PicChannel::jpegEvtHandle).  Hand the HAL a copy of the
+ * handle laid out the way it expects; fds are shared, memory is the same.
+ */
+struct LegacyHandleCache {
+    std::mutex lock;
+    std::unordered_map<const native_handle_t *, buffer_handle_t> map;
+};
+
+LegacyHandleCache gLegacyHandles;
+
+void clearCache() {
+    std::lock_guard<std::mutex> guard(gLegacyHandles.lock);
+    for (auto &entry : gLegacyHandles.map) {
+        native_handle_delete(const_cast<native_handle_t *>(entry.second));
+    }
+    gLegacyHandles.map.clear();
+}
+
+buffer_handle_t *toLegacyHandle(const native_handle_t *src, camera3_stream_t *stream) {
+    if (src == nullptr || src->numFds < 2 || src->numInts < 24) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> guard(gLegacyHandles.lock);
+    auto it = gLegacyHandles.map.find(src);
+    if (it != gLegacyHandles.map.end()) {
+        /* A handle vector can be freed and reallocated at the same address
+         * (new camera session opened), in which case the cached copy points
+         * at a stale buffer.  Only reuse it if the fd still matches. */
+        const native_handle_t *cached = it->second;
+        if (cached != nullptr && cached->data[0] == src->data[0]) {
+            return const_cast<buffer_handle_t *>(&it->second);
+        }
+        native_handle_delete(const_cast<native_handle_t *>(it->second));
+        gLegacyHandles.map.erase(it);
+    }
+    native_handle_t *h = native_handle_create(2, 21);
+    if (h == nullptr) {
+        return nullptr;
+    }
+    memset(h->data, 0, sizeof(int) * (2 + 21));
+    int size = src->data[10];
+    h->data[0] = src->data[0];          // fd
+    h->data[1] = src->data[1];          // fd_metadata
+    h->data[2] = src->data[2];          // magic
+    h->data[3] = src->data[3];          // flags
+    h->data[4] = size;                  // size
+    h->data[5] = 0;                     // offset
+    h->data[6] = 0;                     // bufferType
+    h->data[12] = stream->format;       // format
+    h->data[13] = src->data[6];         // width
+    h->data[14] = size;                 // jpeg length the HAL clamps to the size
+    ALOGD("%s: legacy handle fd=%d size=%d %dx%d format=0x%x", __FUNCTION__,
+            h->data[0], h->data[4], h->data[13], h->data[14], h->data[12]);
+    auto res = gLegacyHandles.map.emplace(src, buffer_handle_t(h));
+    return const_cast<buffer_handle_t *>(&res.first->second);
+}
+
+}  // namespace
+
+void clearLegacyHandles() {
+    clearCache();
+}
+
 void convertFromHidl(
         buffer_handle_t* bufPtr, BufferStatus status, camera3_stream_t* stream, int acquireFence,
         camera3_stream_buffer_t* dst) {
     dst->stream = stream;
-    dst->buffer = bufPtr;
+    buffer_handle_t *legacy = toLegacyHandle(*bufPtr, stream);
+    dst->buffer = (legacy != nullptr) ? legacy : bufPtr;
     dst->status = (int) status;
     dst->acquire_fence = acquireFence;
     dst->release_fence = -1; // meant for HAL to fill in
