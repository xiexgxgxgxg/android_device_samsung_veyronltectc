# First-stage fstab (system-as-root, Android 11).
# init first stage reads /fstab.qcom from the boot ramdisk, mounts the system
# partition as /, then execs /system/bin/init.  Only entries with
# first_stage_mount are used here; /vendor/etc/fstab.qcom is parsed by
# second-stage init for /data, /cache and the firmware partitions.
#
# The platform path (rather than /dev/block/bootdevice) is deliberate: the
# bootdevice symlink is created later by init.qcom.power.rc, while the
# platform path lets first stage wait for the 624000.ufshc uevents.

/dev/block/platform/soc/624000.ufshc/by-name/system  /  ext4  ro,barrier=1  wait,first_stage_mount
